# ==============================================================================
# FDR GUARDIAN: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase PostgreSQL Configuration (Optional)
# If provided, the application connects directly to your live Supabase project.
# If omitted or kept as placeholder, FDR Guardian operates with zero dependencies
# in offline-first persistent browser storage mode pre-seeded with realistic demonstration data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional FastAPI Backend URL (for Python mediated deployments)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Security & Mode Flags
VITE_ENABLE_DEMO_ROLE_SWITCHER=true
VITE_APP_TITLE="FDR Guardian"
